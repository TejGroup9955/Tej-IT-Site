# Backend specific Docker ignore

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/

# Flask session files (these will be recreated)
flask_session/

# Development files
.pytest_cache/
.coverage
htmlcov/

# IDE files
.vscode/
.idea/

# Environment files
.env
.env.local

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore