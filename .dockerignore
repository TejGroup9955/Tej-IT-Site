# Docker ignore file to exclude unnecessary files from build context

# Git files
.git
.gitignore

# Documentation
README.md
readme.md
*.md

# Environment files (these should be set via environment variables)
.env
.env.local
.env.production

# IDE files
.vscode
.idea
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Runtime data
pids/
*.pid
*.seed

# Dependency directories
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs
.next/
dist/
build/

# Test files
coverage/
.nyc_output/
test/
tests/
*.test.js
*.spec.js

# Temporary files
tmp/
temp/